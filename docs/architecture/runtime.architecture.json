      "dot": "cyan",
      "title": "Entry",
      "items": [
        "Assist uses the HACS agent; pick one engine host (App or bundled)",
        "Wyoming :10500 shares AppState with HTTP, not a second parser"
      ]
    },
    {
      "dot": "emerald",
      "title": "Engine",
      "items": [
        "Rule-based nlu::parse — tokenize, resolve, rank, then safety policy",
        "67 language packs bind before parse; schema_version 2.0 on every outcome"
      ]
